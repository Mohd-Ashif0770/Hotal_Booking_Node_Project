<% layout("layouts/boilerplate") %>

<style>
  /* Pointer ONLY on calendar icon */
  input[type="date"]::-webkit-calendar-picker-indicator {
    cursor: pointer;
  }
  input:hover {
  cursor: text;
}
</style>

<div class="container d-flex justify-content-center align-items-center" style="min-height: 75vh;">
  <div class="col-md-7 col-lg-6">

    <div class="card shadow-lg border-0 rounded-4 p-4">

      <h2 class="text-center mb-4 fw-bold">Edit Booking</h2>

      <h5 class="text-center text-muted mb-3">
        <%= booking.listing.title %>
      </h5>

      <form action="/my-bookings/<%= booking._id %>?_method=PUT" method="POST">

        <!-- Start Date -->
        <div class="mb-3">
          <label class="form-label fw-semibold">Start Date</label>
          <input 
            type="date" 
            name="startDate"
            class="form-control form-control-lg rounded-3"
            value="<%= booking.startDate.toISOString().slice(0, 10) %>"
            required
          >
        </div>

        <!-- End Date -->
        <div class="mb-3">
          <label class="form-label fw-semibold">End Date</label>
          <input 
            type="date" 
            name="endDate"
            class="form-control form-control-lg rounded-3"
            value="<%= booking.endDate.toISOString().slice(0, 10) %>"
            required
          >
        </div>

        <!-- Save Changes Button -->
        <button class="btn btn-success btn-lg w-100 mt-3 rounded-3 fw-bold">
          Save Changes
        </button>

      </form>

      <!-- Back Link -->
      <a href="/my-bookings/<%= booking._id %>" class="btn btn-link mt-3 w-100 text-center">
        Cancel and Go Back
      </a>

    </div>

  </div>
</div>
