<% layout("layouts/boilerplate") %>

<div class="container mt-4">
  <h2>My Bookings</h2>

  <% if (bookings.length === 0) { %>
  <p class="text-muted mt-3">You have no bookings yet.</p>
  <% } %>

  <div class="row">
    <% bookings.forEach(b => { %>
    <div class="col-md-4 mt-3">
      <div class="card">
        <% if (b.listing && b.listing.image && b.listing.image.url) { %>
        <img
          src="<%= b.listing.image.url %>"
          class="card-img-top"
          alt="listing"
        />
        <% } %>

        <div class="card-body">
          <h5 class="card-title"><%= b.listing.title %></h5>

          <p class="card-text mb-1">
            <strong>Start Date:</strong> <%= b.startDate.toDateString() %>
          </p>

          <p class="card-text mb-1">
            <strong>End Date:</strong> <%= b.endDate.toDateString() %>
          </p>

          <p class="card-text">
            <strong>Price:</strong>
            <!-- <span class="badge bg-info"><%= b.status %></span> -->
            <span class="badge bg-info"><%= b.listing.price %>/night</span>
          </p>

          <a href="/my-bookings/<%= b._id %>" class="btn btn-primary btn-sm"
            >View Booking</a
          >
        </div>
      </div>
    </div>
    <% }) %>
  </div>
</div>
